{
  "name": "ai-knowledge-base",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "dev": "turbo run dev --env-mode=loose",
    "dev:web": "turbo run dev --env-mode=loose --filter=web...",
    "dev:api": "turbo run dev --env-mode=loose --filter=api...",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint -- --fix && eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:push": "node scripts/db.mjs push",
    "db:types": "node scripts/db.mjs types",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@kb/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  }
}
