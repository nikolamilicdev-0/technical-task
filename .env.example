# ───────── Supabase ─────────
# Local: filled by `pnpm bootstrap --local` from `supabase status`. Hosted: Project Settings → API keys and Data API.
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe key (sb_publishable_… — the legacy anon JWT also works). Exposed to the web app as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Server-only key (sb_secret_… — legacy service_role JWT also works). Used ONLY by the API ingestion worker, usage recorder and readiness probe.
SUPABASE_SECRET_KEY=
# Postgres connection string for db:* scripts only (hosted: Connect → "Session pooler", password percent-encoded).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional, hosted only: with SUPABASE_ACCESS_TOKEN set, `pnpm db:types` reads the schema through the Management API
# (otherwise through SUPABASE_DB_URL). `pnpm bootstrap --hosted` fills it from SUPABASE_URL.
SUPABASE_PROJECT_REF=

# ───────── Web ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ───────── API ─────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000            # CORS allow-list
LOG_LEVEL=log                               # fatal|error|warn|log|debug|verbose (each includes the ones before it)

# ───────── AI: chat (any OpenAI-compatible provider) ─────────
AI_CHAT_PROVIDER=openai                     # openai | groq | together | openrouter | gemini | ollama | custom
AI_CHAT_API_KEY=                            # not needed for ollama or custom
AI_CHAT_MODEL=gpt-4o-mini                   # blank = profile default (custom has none); change or blank it when switching providers
AI_CHAT_BASE_URL=                           # optional override; required for custom
AI_CHAT_TIMEOUT_MS=60000
AI_CHAT_MAX_RETRIES=2
AI_CHAT_STREAM_USAGE=                       # true|false overrides the profile quirk (stream_options.include_usage)
AI_CHAT_TEMPERATURE=                        # empty = provider default (reasoning models reject it)
AI_CHAT_HEADERS_JSON=                       # extra headers as JSON

# ───────── AI: embeddings (independent; Groq serves none) ─────────
AI_EMBEDDING_PROVIDER=                      # default: same as chat
AI_EMBEDDING_API_KEY=                       # default: AI_CHAT_API_KEY when the provider matches
AI_EMBEDDING_MODEL=text-embedding-3-small  # blank = profile default (custom has none); change or blank it when switching providers
AI_EMBEDDING_BASE_URL=                      # default: chat value when the provider matches
AI_EMBEDDING_DIMENSIONS=                    # optional; ≤1536 is zero-padded to the column, >1536 needs the column migration
AI_EMBEDDING_BATCH_SIZE=32
AI_EMBEDDING_TIMEOUT_MS=30000
AI_EMBEDDING_MAX_RETRIES=2
AI_EMBEDDING_HEADERS_JSON=                  # default: chat value when the provider matches
AI_APP_NAME=ai-knowledge-base               # OpenRouter attribution headers
AI_APP_URL=http://localhost:3000

# ───────── RAG knobs ─────────
RAG_RETRIEVAL_MODE=hybrid                   # hybrid | vector
RAG_QUERY_REWRITE=true                      # condense follow-ups into standalone queries (skipped on first turn)
RAG_VECTOR_K=20
RAG_KEYWORD_K=20
RAG_TOP_N=6
RAG_MIN_SIMILARITY=0
RAG_RRF_K=60
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_HISTORY_TOKEN_BUDGET=2000
RAG_MAX_ANSWER_TOKENS=1024

# ───────── Ingestion worker ─────────
INGESTION_WORKER_ENABLED=true
INGESTION_SWEEP_INTERVAL_MS=30000
INGESTION_BATCH_SIZE=5
INGESTION_STALE_AFTER_MINUTES=10
INGESTION_MAX_ATTEMPTS=5

# ───────── Rate limits (per user, per route, per minute; uploads 10 and reindex 3 are fixed) ─────────
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=20

# Examples (README "How to swap providers" has more)
#   Groq chat + OpenAI embeddings: AI_CHAT_PROVIDER=groq AI_CHAT_API_KEY=gsk_... AI_CHAT_MODEL=llama-3.3-70b-versatile AI_EMBEDDING_PROVIDER=openai AI_EMBEDDING_API_KEY=sk-...
#   Fully local (Ollama started with OLLAMA_CONTEXT_LENGTH=8192): AI_CHAT_PROVIDER=ollama AI_CHAT_MODEL=llama3.2 AI_EMBEDDING_PROVIDER=ollama AI_EMBEDDING_MODEL=nomic-embed-text
#   Google Gemini (chat + embeddings, 1536 dimensions via the profile): AI_CHAT_PROVIDER=gemini AI_CHAT_API_KEY=... AI_CHAT_MODEL= AI_EMBEDDING_MODEL=
